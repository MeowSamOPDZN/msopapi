# Server & Database
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
DB_PATH=./data/gateway.sqlite

# Admin Authentication (required to sign in at /admin)
ADMIN_PASSWORD=change-me-strong-password

# Public Branding & Origins
SITE_NAME=MsopAPI
SITE_URL=https://msopapi.vercel.app
API_BASE_URL=https://msopapi.vercel.app/v1
API_ORIGIN=https://msopapi.vercel.app
CONTACT_EMAIL=info@msopapi.vercel.app
CORS_ORIGINS=https://msopapi.vercel.app,http://localhost:5173,http://127.0.0.1:5173
COOKIE_DOMAIN=

# Customer Google OAuth (optional — required for "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
